MAPS_LIST_URL=https://maps.app.goo.gl/REEMPLAZA_ESTO
MAPS_TIMEZONE=America/Bogota
MAPS_LOCALE=es-CO
MAPS_HEADLESS=1
MAPS_BROWSER_CHANNEL=chrome
MAPS_OUT_DIR=data
MAPS_OUT_BASENAME=mis_lugares_sin_gluten

# Perfil persistente para listas privadas (solo si ejecutaste el login)
# MAPS_PROFILE_DIR=.auth

# Enriquecido con la web de cada local
# MAPS_ENRICH=1
# MAPS_ENRICH_DAYS=30
# MAPS_OCR=0

# Búsqueda de web cuando Maps no la trae (SerpAPI + Brave como fallback,
# + validación Gemini). Requiere GEMINI_API_KEY y SERPAPI_KEY y/o BRAVE_API_KEY.
# Activada por defecto (1). Para desactivar: 0 o --no-website-search.
# MAPS_WEBSITE_SEARCH=1
# GEMINI_SEARCH_MODEL=gemini-flash-lite-latest
# GEMINI_API_KEY=
# SERPAPI_KEY=
# BRAVE_API_KEY=

# Apify (carta estructurada; opcional)
# MAPS_APIFY=1
# MAPS_MENU_ACTOR=unitbytes
# MAPS_WEBSITE_MENU=0
# APIFY_TOKEN=
# APIFY_LANGUAGE=es
# APIFY_MAX_PHOTOS=8
# APIFY_MAX_CHARGE_USD=2.0
# APIFY_CONCURRENCY=5

# Diagnóstico y sincronización
# MAPS_DEBUG=0
# MAPS_SYNC_DRIVE=0
# RCLONE_REMOTE=gdrive
# RCLONE_DIR=NotebookLM

# Google Doc (solo para `python -m maps_gluten publish`)
# GDOC_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/ruta/service-account.json
